{
  "name": "mlcrough",
  "version": "5.2.0",
  "description": "Create graphics using SVG with a hand-drawn, sketchy, appearance.",
  "type": "module",
  "main": "dist/mlcrough.js",
  "exports": {
    ".": "./dist/mlcrough.js"
  },
  "types": "dist/mlcrough.d.ts",
  "scripts": {
    "dev": "node build.js --watch",
    "build": "rm -rf dist && tsc --noEmit && node build.js && dts-bundle-generator -o dist/mlcrough.d.ts src/mlcrough.ts",
    "lint": "eslint src",
    "test": "echo \"Error: no test specified\" && exit 1",
    "example:rectangle": "tsx examples/rectangle.ts",
    "example:rectangle2": "tsx examples/rectangle2.ts",
    "example:circle": "tsx examples/circle.ts",
    "example:ellipse": "tsx examples/ellipse.ts",
    "example:line": "tsx examples/line.ts",
    "example:polygon": "tsx examples/polygon.ts",
    "example:dashed-rectangle": "tsx examples/dashed-rectangle.ts",
    "example:dashed-line": "tsx examples/dashed-line.ts",
    "example:dashed-polygon": "tsx examples/dashed-polygon.ts",
    "example:dashed-ellipse": "tsx examples/dashed-ellipse.ts",
    "example:barchart": "tsx examples/barchart.ts",
    "example:piechart": "tsx examples/piechart.ts",
    "example:piechart3d": "tsx examples/piechart3d.ts",
    "example:piechart3d-advanced": "tsx examples/piechart3d_advanced.ts",
    "example:ridgeplot": "tsx examples/ridgeplot.ts",
    "example:multi-style-fill": "tsx examples/multi-style-fill.ts",
    "example:gradient-fills": "tsx examples/gradient-fills.ts",
    "example:multi-dot-fill": "tsx examples/multi-dot-fill.ts",
    "example:opacity-range": "tsx examples/opacity-range.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlechner911/mlcrough.git"
  },
  "keywords": [
    "svg",
    "graphics",
    "sketchy",
    "hand drawn",
    "hand-drawn"
  ],
  "author": "Michael Lechner",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mlechner911/mlcrough/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "ml-time-graph": "^1.3.3",
    "tslib": "^2.8.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "hachure-fill": "^0.5.2",
    "points-on-curve": "^1.0.1"
  }
}
